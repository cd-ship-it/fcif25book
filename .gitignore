# Python venv used by extract.py/generate.py — regenerate with:
#   python3 -m venv .venv && ./.venv/bin/pip install pymupdf
.venv/

__pycache__/
*.pyc

.DS_Store

# Source PDF — large binary, not needed to build/deploy the site
# (extract.py needs it locally to regenerate assets/data, but it's not
# tracked in the repo).
*.pdf
