---
import '../styles/page-flip-base.css';
import '../styles/app.css';
import '../styles/details.css';
import '../styles/photo-lightbox.css';
import config from '../config/flipbook.config';
import manifest from '../generated/manifest.json';
import { readMoreLinks } from '../config/readmore.config';

interface PageMeta {
  page: number;
  title: string;
  bgExt?: string;
}

interface DetailFrontmatter {
  title: string;
  subtitle?: string;
  page: number;
}

// "閱讀全文" (Read Full Text) buttons -> details modal. Every markdown file
// under src/details/ is loaded and matched up against readmore.config.ts by
// filename; a link with no matching file is skipped (with a build-time
// warning) rather than breaking the build, so a not-yet-written details page
// just quietly has no popup instead of failing `npm run build`.
const detailModules = import.meta.glob('../details/*.md', { eager: true }) as Record<
  string,
  { frontmatter: DetailFrontmatter; Content: any }
>;

const detailPanels = readMoreLinks
  .map((link) => {
    const key = Object.keys(detailModules).find((k) => k.endsWith(`/${link.detailsFile}.md`));
    if (!key) {
      console.warn(`[readmore] No src/details/${link.detailsFile}.md for page ${link.page} (element #${link.elementId}) — skipping.`);
      return null;
    }
    const mod = detailModules[key];
    return { ...link, frontmatter: mod.frontmatter, Content: mod.Content };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

// Eagerly load every generated page fragment as raw HTML text. Using a glob
// (rather than per-page imports) means this scales to all 93 pages later
// without editing this file — just re-run the sync script.
const fragmentModules = import.meta.glob('../generated/fragments/*.html', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

function fragmentFor(n: number): string {
  const key = Object.keys(fragmentModules).find((k) => k.endsWith(`/page${n}.html`));
  if (!key) throw new Error(`Missing generated fragment for page ${n}. Run scripts/sync-from-source.mjs.`);
  return fragmentModules[key];
}

// import.meta.env.BASE_URL reflects astro.config.mjs's `base` — every
// root-absolute URL in this file must go through it, since GitHub Pages
// serves this as a project site under a /fcif25book subpath, not at the
// domain root. Its trailing-slash presence isn't guaranteed across Astro
// versions/configs (observed WITHOUT one here), so join defensively rather
// than assuming either way.
function withBase(path: string): string {
  return `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
}

const pages = (manifest.pages as PageMeta[]).map((p) => ({
  ...p,
  html: fragmentFor(p.page),
  thumb: withBase(`assets/backgrounds/page${p.page}.${p.bgExt || 'png'}`),
}));

const total = manifest.total as number;
---

<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>基督豐榮：同行25載</title>
  <link rel="icon" href={withBase('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet" />
  <!-- Generated by ../generate.py + scripts/sync-from-source.mjs — do not hand-edit. -->
  <link rel="stylesheet" href={withBase('generated/book.css')} />
</head>
<style define:vars={{
  fpPrimary: config.palette.primary,
  fpPrimaryDark: config.palette.primaryDark,
  fpGold: config.palette.accentGold,
  fpGreen: config.palette.accentGreen,
  fpBg: config.palette.background,
  fpBgGradient: config.palette.backgroundGradient,
  fpToolbarBg: config.palette.toolbarBg,
  fpToolbarText: config.palette.toolbarText,
  fpToolbarBorder: config.palette.toolbarBorder,
  fpPageShadow: config.palette.pageShadow,
}}>
  /* Palette values from src/config/flipbook.config.ts, exposed as CSS vars
     (--fpPrimary etc.) on <html> so every stylesheet on the page can use them. */
</style>
<body>
  <div id="app">
    {config.toolbar.hideOnDesktopUntilToggled && (
      <button
        id="btn-toolbar-toggle"
        type="button"
        aria-label={config.labels.toolbarToggle}
        aria-expanded="false"
      >
        ⋮
      </button>
    )}
    <header class="toolbar">
      <span class="brand">基督豐榮．同行25載</span>
      <div class="spacer"></div>
      <div class="group nav-group">
        <button id="btn-prev" type="button" aria-label={config.labels.prev}>← {config.labels.prev}</button>
        <span id="page-indicator" class="page-indicator"></span>
        <button id="btn-next" type="button" aria-label={config.labels.next}>{config.labels.next} →</button>
      </div>
      <div class="spacer"></div>
      <div class="group">
        {config.toolbar.showPageJump && (
          <form id="jump-form" class="jump-form">
            <input
              id="jump-input"
              type="number"
              min="1"
              max={total}
              placeholder={config.labels.jumpPlaceholder}
              aria-label={config.labels.jumpPlaceholder}
            />
            <button type="submit" class="btn">{config.labels.jumpButton}</button>
          </form>
        )}
        {config.toolbar.showFullscreen && (
          <button id="btn-fullscreen" type="button" class="btn">{config.labels.fullscreenEnter}</button>
        )}
        {config.toolbar.showThumbnails && (
          <button id="btn-toc" type="button" class="btn">{config.labels.tocButton}</button>
        )}
      </div>
    </header>

    <div id="stage">
      <div class="loading-note" id="loading-note">{config.labels.loading}</div>
      <div id="book-shell">
        <div id="book">
          {pages.map((p) => <Fragment set:html={p.html} />)}
        </div>
      </div>
    </div>

    {config.responsive.bottomNavOnMobile && (
      <nav id="bottom-nav" aria-label="頁面導覽">
        <button id="btn-prev-mobile" type="button" class="dock-btn" aria-label={config.labels.prev}>‹</button>
        <span id="page-indicator-mobile" class="sr-only"></span>
        <button id="btn-next-mobile" type="button" class="dock-btn" aria-label={config.labels.next}>›</button>
      </nav>
    )}
  </div>

  {config.toolbar.showThumbnails && (
    <Fragment>
      <div id="toc-backdrop"></div>
      <aside id="toc-drawer">
        <h2>{config.labels.tocTitle}</h2>
        {pages.map((p) => (
          <div class="toc-item" data-goto={p.page}>
            <img src={p.thumb} alt="" loading="lazy" />
            <span class="toc-label">
              <span class="toc-num">第 {p.page} 頁</span>
              {p.title}
            </span>
          </div>
        ))}
      </aside>
    </Fragment>
  )}

  {detailPanels.length > 0 && (
    <div id="detail-overlay" aria-hidden="true">
      <div id="detail-card" role="dialog" aria-modal="true">
        <button type="button" id="detail-close" aria-label="關閉">✕</button>
        <div id="detail-body">
          {detailPanels.map((d) => (
            <article class="detail-panel" data-detail-panel={d.detailsFile} hidden>
              <h2 class="detail-title">{d.frontmatter.title}</h2>
              {d.frontmatter.subtitle && <p class="detail-subtitle">{d.frontmatter.subtitle}</p>}
              <div class="detail-content">
                <d.Content />
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  )}

  <div id="photo-lightbox" aria-hidden="true">
    <button type="button" id="photo-lightbox-close" aria-label="關閉">✕</button>
    <img id="photo-lightbox-img" src="" alt="" />
  </div>

  <script>
    import '../scripts/flipbook.client.ts';
    import '../scripts/readmore.client.ts';
    import '../scripts/photo-zoom.client.ts';
    import '../scripts/photo-album.client.ts';
    import '../scripts/timeline-tooltip.client.ts';
  </script>
</body>
</html>
