---
// MOBILE DEBUG BUILD — temporarily replaces the real app on this branch.
// Purpose: divide-and-conquer test for the "any touch on mobile shifts the
// whole viewport, only a reload fixes it" bug (reported on both Safari and
// Chrome on iOS, and unfixed by two prior attempts: disabling native
// pinch-zoom, then pinning html/body with position:fixed). This page is
// deliberately as close to the ORIGINAL standalone page35.html as possible:
// one page, in normal document flow, no page-flip, no toc-drawer, no
// fullscreen button, no resize/orientationchange/visualViewport JS at all,
// and none of app.css's scroll-lock CSS either.
//
// ROUND 2: round 1 (no #bottom-nav at all) held up fine on real Safari and
// Chrome on iOS — no shifting. Round 2 added back ONLY the #bottom-nav
// floating dock (position:fixed, exact CSS/markup copied from app.css/
// index.astro), inert buttons — also held up fine, so a fixed-position
// element on screen by itself isn't the cause either.
//
// ROUND 3: the one big architectural difference left untested is HOW the
// page scrolls. Rounds 1-2 let the plain document/body scroll natively.
// The real app instead nests scrolling inside #app (height:100%, flex
// column) > #stage (overflow-y:auto, -webkit-overflow-scrolling:touch —
// iOS's old momentum-scroll opt-in, a well-known source of exactly this
// class of desync bug when combined with a position:fixed sibling like
// #bottom-nav). This round reproduces that exact nested-scroll-container
// structure (CSS/markup copied from app.css/index.astro) around the same
// page35 content, still with #bottom-nav, still with zero resize/fit JS.
// If the bug reappears now, the nested momentum-scroll container is the
// cause. If it still doesn't, the next round adds the resize/fit JS itself.
function withBase(path: string): string {
  return `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
}
---

<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mobile Debug — Page 35 (minimal)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={withBase('generated/book.css')} />
  <style>
    /* Debug-only additions — not part of the real site's CSS. A bare-bones
       stand-in for the real readmore detail panel; just enough to test
       tapping a "閱讀全文" trigger without pulling in readmore.client.ts,
       flipbook.config, or the markdown content pipeline. */
    #debug-banner {
      background: #c0392b;
      color: #fff;
      font-size: 12px;
      text-align: center;
      padding: 6px;
    }
    #debug-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    #debug-modal.open {
      display: flex;
    }
    #debug-modal-card {
      background: #fff;
      border-radius: 8px;
      padding: 24px;
      max-width: 380px;
      font-size: 15px;
      line-height: 1.6;
    }
    #debug-modal-close {
      margin-top: 16px;
      padding: 8px 16px;
    }

    /* Exact copy of app.css's #bottom-nav — round 2's only addition.
       Always display:flex here (no #app.mobile-mode gate to wire up),
       buttons are inert (no click handlers, no page-flip behind them). */
    #bottom-nav {
      position: fixed;
      left: 50%;
      bottom: calc(12px + env(safe-area-inset-bottom));
      transform: translateX(-50%);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
    }
    #bottom-nav .dock-btn {
      appearance: none;
      border: none;
      background: rgba(0, 0, 0, 0.06);
      color: #262229;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      font-size: 20px;
      line-height: 1;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Round 3's only addition: the real app's nested momentum-scroll
       container (app.css's html,body / #app / #app.mobile-mode #stage
       rules, copied verbatim), replacing rounds 1-2's plain document
       scroll. No resize/fit JS yet — the page renders at its native
       695px width, just scrollable inside #stage instead of the body. */
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
      background: #6b6b6b;
    }
    #app {
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    #stage {
      flex: 1 1 auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background: #ffffff;
      padding: 0 0 calc(68px + env(safe-area-inset-bottom));
      display: flex;
      justify-content: center;
    }
  </style>
</head>
<body>
  <div id="app">
    <div id="debug-banner">MOBILE DEBUG ROUND 3 — page 35 + #bottom-nav + nested #stage momentum-scroll container, still no resize/fit JS</div>
    <div id="stage">
      <div class="page" id="page35">
        <div class="t" id="p35-t1">女教牧事工</div>
        <div class="t" id="p35-t2" role="button" tabindex="0" aria-label="閱讀全文">閱讀全文</div>
        <div class="t" id="p35-t3">大約十年前，神感動丈夫和我來到現在的教會服事，因</div>
        <div class="t" id="p35-t4">著全新的角色及陌生的環境，我逐漸感受到當師母那份</div>
        <div class="t" id="p35-t5">不為人知的孤單……</div>
        <div class="t" id="p35-t6">生命中的伊利莎白</div>
        <div class="t" id="p35-t7">張麗珊（Karol Lam）｜聖經原文研經小組組員 </div>
        <div class="t" id="p35-t8">2026年張麗珊（右上）與原文研究小組組員共聚。</div>
        <div class="photo-zoom" id="p35-photo1" data-photo-src={withBase('assets/photos/page35-photo1.jpg')} role="button" tabindex="0" aria-label="放大照片"></div>
        <div class="page-num" id="p35-pagenum">35</div>
      </div>
    </div>

    <nav id="bottom-nav" aria-label="頁面導覽 (inert — round 3 test)">
      <button type="button" class="dock-btn" aria-label="上一頁">‹</button>
      <button type="button" class="dock-btn" aria-label="下一頁">›</button>
    </nav>
  </div>

  <div id="debug-modal">
    <div id="debug-modal-card">
      <p>Stand-in for the real "read more" panel — here only to test tapping a fixed-position overlay, not the actual article content.</p>
      <button type="button" id="debug-modal-close">Close</button>
    </div>
  </div>

  <script>
    document.getElementById('p35-t2')?.addEventListener('click', () => {
      document.getElementById('debug-modal')?.classList.add('open');
    });
    document.getElementById('debug-modal-close')?.addEventListener('click', () => {
      document.getElementById('debug-modal')?.classList.remove('open');
    });
  </script>
</body>
</html>
