---
// MOBILE DEBUG BUILD — temporarily replaces the real app on this branch.
// Purpose: divide-and-conquer test for the "any touch on mobile shifts the
// whole viewport, only a reload fixes it" bug (reported on both Safari and
// Chrome on iOS, and unfixed by two prior attempts: disabling native
// pinch-zoom, then pinning html/body with position:fixed). This page is
// deliberately as close to the ORIGINAL standalone page35.html as possible:
// one page, in normal document flow, no page-flip, no #bottom-nav, no
// toc-drawer, no fullscreen button, no resize/orientationchange/
// visualViewport JS at all, and none of app.css's scroll-lock CSS either.
// If the bug still reproduces here, it isn't caused by any of that — it's
// something more fundamental. If it doesn't, the next round adds pieces
// back one at a time until it breaks again.
function withBase(path: string): string {
  return `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
}
---

<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mobile Debug — Page 35 (minimal)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={withBase('generated/book.css')} />
  <style>
    /* Debug-only additions — not part of the real site's CSS. A bare-bones
       stand-in for the real readmore detail panel; just enough to test
       tapping a "閱讀全文" trigger without pulling in readmore.client.ts,
       flipbook.config, or the markdown content pipeline. */
    #debug-banner {
      background: #c0392b;
      color: #fff;
      font-size: 12px;
      text-align: center;
      padding: 6px;
    }
    #debug-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    #debug-modal.open {
      display: flex;
    }
    #debug-modal-card {
      background: #fff;
      border-radius: 8px;
      padding: 24px;
      max-width: 380px;
      font-size: 15px;
      line-height: 1.6;
    }
    #debug-modal-close {
      margin-top: 16px;
      padding: 8px 16px;
    }
  </style>
</head>
<body>
  <div id="debug-banner">MOBILE DEBUG BUILD — page 35 only, no page-flip / bottom-nav / scroll-lock CSS</div>
  <div class="pagewrap">
    <div class="page" id="page35">
      <div class="t" id="p35-t1">女教牧事工</div>
      <div class="t" id="p35-t2" role="button" tabindex="0" aria-label="閱讀全文">閱讀全文</div>
      <div class="t" id="p35-t3">大約十年前，神感動丈夫和我來到現在的教會服事，因</div>
      <div class="t" id="p35-t4">著全新的角色及陌生的環境，我逐漸感受到當師母那份</div>
      <div class="t" id="p35-t5">不為人知的孤單……</div>
      <div class="t" id="p35-t6">生命中的伊利莎白</div>
      <div class="t" id="p35-t7">張麗珊（Karol Lam）｜聖經原文研經小組組員 </div>
      <div class="t" id="p35-t8">2026年張麗珊（右上）與原文研究小組組員共聚。</div>
      <div class="photo-zoom" id="p35-photo1" data-photo-src={withBase('assets/photos/page35-photo1.jpg')} role="button" tabindex="0" aria-label="放大照片"></div>
      <div class="page-num" id="p35-pagenum">35</div>
    </div>
  </div>

  <div id="debug-modal">
    <div id="debug-modal-card">
      <p>Stand-in for the real "read more" panel — here only to test tapping a fixed-position overlay, not the actual article content.</p>
      <button type="button" id="debug-modal-close">Close</button>
    </div>
  </div>

  <script>
    document.getElementById('p35-t2')?.addEventListener('click', () => {
      document.getElementById('debug-modal')?.classList.add('open');
    });
    document.getElementById('debug-modal-close')?.addEventListener('click', () => {
      document.getElementById('debug-modal')?.classList.remove('open');
    });
  </script>
</body>
</html>
